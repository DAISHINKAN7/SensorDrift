# SensorDrift Environment Variables
# Copy this file to .env and update values as needed

# PostgreSQL Configuration
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=gas_monitoring
POSTGRES_USER=sensordrift
POSTGRES_PASSWORD=sensordrift_password

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379

# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=kafka:29092
KAFKA_TOPIC_SENSOR_READINGS=sensor-readings

# MinIO Configuration
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=minio:9000

# Airflow Configuration
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://airflow:airflow@airflow-postgres/airflow

# Flask Configuration
FLASK_ENV=production
FLASK_DEBUG=False

# Data Paths
REAL_DATA_PATH=/app/data/combined_sensor_data_clean.csv
SYNTH_DATA_PATH=/app/data/realistic_synthetic_gas_300k.csv

# Model Paths
MODEL_DIR=/app/model/

# Monitoring
ENABLE_MONITORING=true
LOG_LEVEL=INFO
